{
  "name": "wrapvisualizer",
  "private": true,
  "version": "1.0.0",
  "description": "Mobile-first vehicle wrap visualization and booking tool for Nairobi",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "cd backend && node server.js",
    "start": "cd backend && node server.js",
    "build:css": "tailwindcss -c frontend/tailwind.config.js -i frontend/src/input.css -o frontend/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c frontend/tailwind.config.js -i frontend/src/input.css -o frontend/assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.14"
  }
}
