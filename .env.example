# WrapVisualizer — environment variables
#
# Copy this file to `.env.local` at the repo root for local development.
# On Railway / Fly / any PaaS, set these via the platform's env var UI
# instead — platform env vars override .env.local.

# -----------------------------------------------------------------------------
# REQUIRED (for /api/segment AI vehicle masking)
# -----------------------------------------------------------------------------

# Replicate API token used by the backend to call the meta/sam-2 model.
# Get one at https://replicate.com/account/api-tokens
# Without this, /api/segment returns 500 and the frontend falls through
# to the raw upload with a dismissible banner on screen 2.
REPLICATE_API_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Port the Express server listens on. Defaults to 3000. Railway/Fly set
# this automatically; leave unset in production.
# PORT=3000

# URL of a separately-deployed frontend, if you split frontend + backend
# across two domains. Same-origin deploys (backend serves the static
# frontend) do NOT need this.
# FRONTEND_URL=https://wrap.example.com

# Sentry DSN for backend error forwarding. If unset, Sentry middleware
# is a no-op. Create a Node.js project at https://sentry.io to get one.
# SENTRY_DSN=

# Pin the Replicate SAM-2 model to a specific version hash. Leave unset
# to auto-route to the latest active version (recommended).
# REPLICATE_SAM2_VERSION=

# How often (ms) the backend re-validates the Replicate token against
# /v1/account so /api/health stays accurate after a mid-uptime token
# rotation. Defaults to 60000 (60s). Set to 0 to disable (e.g. for
# tests that don't want background activity).
# REPLICATE_REVALIDATE_MS=60000
