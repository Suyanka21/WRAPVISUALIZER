# ============================================================
# WrapVisualizer Backend — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.
# ============================================================

# --- Server ---
PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Replicate API (for SAM image segmentation) ---
# The ONLY server-side secret. Required for the segmentation endpoint
# used on the upload screen. Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here
